
openapi: 3.0.3
info:
  version: "1.0.1"
  title: "Metadata Uses DDI Analysis Unit Vocabulary"
  x-tests_metric: "https://doi.org/10.25504/FAIRsharing.236b80"
  description: >-
    "Checks if certain information elements contain terms from the DDI Analysis Unit controlled vocabulary."
  x-applies_to_principle: "https://doi.org/10.25504/FAIRsharing.96d4af"
  contact:
    x-organization: "Consortium of European Social Science Data Archives"
    url: "https://cessda.eu"
    name: "John Shepherdson"
    x-role: responsible developer
    email: "john.shepherdson@cessda.eu"
    x-id: "https://orcid.org/0000-0002-4402-9644"
paths:
  "/ddi-analysis-unit":
    post:
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/schemas"
        required: true
      responses:
        "200":
          description:  >-
            The response is "pass", "fail" or "indeterminate"
servers:
  - url: "https://fair-tests.cessda.eu/assess/test"
components:
  schemas:
    schemas:
      type: object
      required:
        - resource_identifier
      properties:
        resource_identifier:
          type: string
          description: the GUID being tested
